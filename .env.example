# Opcional: entrega de codigo por WhatsApp na autenticacao do cliente
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TEMPLATE_NAME=
WHATSAPP_VERIFY_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_GRAPH_API_VERSION=v23.0

# Obrigatorio em producao: persistencia real dos pedidos
DATABASE_URL=

# Obrigatorio em producao: acesso privado do gestor
# Preferido: lista de admins em JSON, cada um com login, displayName e passwordHash ou password
# Exemplo:
# ADMIN_USERS=[{"login":"usermaster@inovas.com","displayName":"Master INovas Food","passwordHash":"scrypt$86ac0598d0f91a4f0dc658f3ab8d9efa$e76389dd24cd49fe9fb89f75d65f5c865abdd8d359a99f4c1a01022fd121caadddd2f9b501b2e59f24eba2336d02e0de4207305f7fdd680fc945ec341b835932"}]
ADMIN_USERS=
# Legado: admin unico, mantido por compatibilidade temporaria
ADMIN_LOGIN=usermaster@inovas.com
ADMIN_PASSWORD_HASH=scrypt$86ac0598d0f91a4f0dc658f3ab8d9efa$e76389dd24cd49fe9fb89f75d65f5c865abdd8d359a99f4c1a01022fd121caadddd2f9b501b2e59f24eba2336d02e0de4207305f7fdd680fc945ec341b835932
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Master INovas Food
ADMIN_SESSION_SECRET=

# Recomendado: sessao assinada da area autenticada do cliente
CUSTOMER_SESSION_SECRET=

# Obrigatorio em producao: origens autorizadas para o checkout publico
ALLOWED_PUBLIC_ORIGINS=https://tokyosushidelivery.com.br

# Opcional: contexto interno de tenant.
# default_only preserva Tokyo/default. strict deve ser usado apenas depois do cutover multi-tenant.
INOVAS_TENANT_MODE=default_only

# Recomendado: protecao inicial contra abuso no endpoint publico de pedidos
ORDER_RATE_LIMIT_WINDOW_MS=300000
ORDER_RATE_LIMIT_MAX_REQUESTS=6
ORDER_MAX_BODY_BYTES=65536

# Recomendado: limites do login publico do cliente
CUSTOMER_AUTH_RATE_LIMIT_WINDOW_MS=600000
CUSTOMER_AUTH_START_MAX_REQUESTS=6
CUSTOMER_AUTH_VERIFY_MAX_REQUESTS=10
