# Opcional: entrega de codigo por WhatsApp na autenticacao do cliente.
WHATSAPP_ACCESS_TOKEN=replace-with-provider-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_VERIFY_TEMPLATE_NAME=replace-with-template-name
WHATSAPP_VERIFY_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_GRAPH_API_VERSION=v23.0

# Opcional: chave browser do Google Maps. Deve estar restrita por HTTP referrer,
# APIs estritamente necessarias e quota/alertas no Google Cloud.
GOOGLE_MAPS_API_KEY=replace-with-restricted-browser-key

# Obrigatorio em producao: persistencia real dos pedidos.
DATABASE_URL=postgresql://user:password@host/database

# Obrigatorio em producao: acesso privado do gestor.
# Preferido: lista JSON de admins com login, displayName e passwordHash.
ADMIN_USERS=[{"login":"change-me@example.com","displayName":"Change Me","passwordHash":"replace-with-generated-hash","userType":"MASTER","platformScope":true}]

# Legado: admin unico, mantido por compatibilidade temporaria.
ADMIN_LOGIN=change-me@example.com
ADMIN_PASSWORD_HASH=replace-with-generated-hash
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Change Me
ADMIN_SESSION_SECRET=replace-with-random-secret

# Recomendado: sessao assinada da area autenticada do cliente.
CUSTOMER_SESSION_SECRET=replace-with-random-secret

# Obrigatorio em producao: origens autorizadas para o checkout publico.
ALLOWED_PUBLIC_ORIGINS=https://example.com

# Opcional: contexto interno de tenant.
# default_only preserva Tokyo/default. strict deve ser usado apenas depois do cutover multi-tenant.
INOVAS_TENANT_MODE=default_only

# Origem publica oficial. As URLs de restaurantes usam /{slug}, sem subdominio.
PUBLIC_APP_URL=https://www.inovasfood.com.br

# Convites administrativos: o token e persistido somente como hash.
# A entrega por e-mail permanece desativada ate a integracao de um provedor.
INOVAS_INVITE_TTL_HOURS=48
INOVAS_ADMIN_PUBLIC_URL=https://preview.example.com
# Habilite a copia manual do link apenas em ambientes administrativos controlados.
INOVAS_ALLOW_INVITE_LINK_COPY=false
# Reservado para a futura integracao real de e-mail (nao marcar envio antes disso).
INOVAS_INVITE_EMAIL_PROVIDER=
INOVAS_INVITE_EMAIL_FROM=
INOVAS_INVITE_EMAIL_API_KEY=

# Recomendado: protecao inicial contra abuso no endpoint publico de pedidos.
ORDER_RATE_LIMIT_WINDOW_MS=300000
ORDER_RATE_LIMIT_MAX_REQUESTS=6
ORDER_MAX_BODY_BYTES=65536

# Recomendado: limites do login publico do cliente.
CUSTOMER_AUTH_RATE_LIMIT_WINDOW_MS=600000
CUSTOMER_AUTH_START_MAX_REQUESTS=6
CUSTOMER_AUTH_VERIFY_MAX_REQUESTS=10
