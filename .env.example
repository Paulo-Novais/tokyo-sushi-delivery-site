# Opcional: entrega de codigo por WhatsApp na autenticacao do cliente
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TEMPLATE_NAME=
WHATSAPP_VERIFY_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_GRAPH_API_VERSION=v23.0

# Obrigatorio em producao: persistencia real dos pedidos
DATABASE_URL=

# Obrigatorio em producao: acesso privado do gestor
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Gestor Tokyo
ADMIN_SESSION_SECRET=

# Recomendado: sessao assinada da area autenticada do cliente
CUSTOMER_SESSION_SECRET=

# Obrigatorio em producao: origens autorizadas para o checkout publico
ALLOWED_PUBLIC_ORIGINS=https://tokyosushidelivery.com.br

# Recomendado: protecao inicial contra abuso no endpoint publico de pedidos
ORDER_RATE_LIMIT_WINDOW_MS=300000
ORDER_RATE_LIMIT_MAX_REQUESTS=6
ORDER_MAX_BODY_BYTES=65536

# Recomendado: limites do login publico do cliente
CUSTOMER_AUTH_RATE_LIMIT_WINDOW_MS=600000
CUSTOMER_AUTH_START_MAX_REQUESTS=6
CUSTOMER_AUTH_VERIFY_MAX_REQUESTS=10
