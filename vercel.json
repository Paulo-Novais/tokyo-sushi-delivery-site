{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "tokyosushidelivery.com.br"
        }
      ],
      "destination": "/tokyo-robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "tokyosushidelivery.com.br"
        }
      ],
      "destination": "/tokyo-sitemap.xml"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tokyosushidelivery.com.br"
        }
      ],
      "destination": "/tokyo.html"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "tokyosushidelivery.com.br"
        }
      ],
      "destination": "/tokyo.html"
    },
    {
      "source": "/r/tokyo-sushi/",
      "destination": "/tokyo.html"
    },
    {
      "source": "/r/tokyo-sushi/index.html",
      "destination": "/tokyo.html"
    },
    {
      "source": "/r/tokyo-sushi/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/inovas",
      "destination": "/inovas.html"
    },
    {
      "source": "/api/admin/login",
      "destination": "/api/admin/[...action]?action=auth/login"
    },
    {
      "source": "/api/admin/logout",
      "destination": "/api/admin/[...action]?action=auth/logout"
    },
    {
      "source": "/api/admin/session",
      "destination": "/api/admin/[...action]?action=auth/session"
    },
    {
      "source": "/api/admin/auth/:action",
      "destination": "/api/admin/[...action]?action=auth/:action"
    },
    {
      "source": "/api/admin/master/:action",
      "destination": "/api/admin/[...action]?action=master/:action"
    },
    {
      "source": "/api/admin/users/:action",
      "destination": "/api/admin/[...action]?action=users/:action"
    },
    {
      "source": "/api/admin/orders/:action",
      "destination": "/api/admin/[...action]?action=orders/:action"
    },
    {
      "source": "/api/admin/catalog/:action",
      "destination": "/api/admin/[...action]?action=catalog/:action"
    },
    {
      "source": "/api/admin/promotions/:action",
      "destination": "/api/admin/[...action]?action=promotions/:action"
    },
    {
      "source": "/api/admin/reviews/:action",
      "destination": "/api/admin/[...action]?action=reviews/:action"
    },
    {
      "source": "/api/admin/delivery-settings/:action",
      "destination": "/api/admin/[...action]?action=delivery-settings/:action"
    },
    {
      "source": "/api/admin/settings/:action",
      "destination": "/api/admin/[...action]?action=settings/:action"
    },
    {
      "source": "/api/admin/customers/:action",
      "destination": "/api/admin/[...action]?action=customers/:action"
    },
    {
      "source": "/api/admin/inventory/:action",
      "destination": "/api/admin/[...action]?action=inventory/:action"
    },
    {
      "source": "/api/admin/finance",
      "destination": "/api/admin/[...action]?action=finance"
    },
    {
      "source": "/api/customer/auth/:action",
      "destination": "/api/customer/[...action]?action=auth/:action"
    },
    {
      "source": "/api/customer/orders/active",
      "destination": "/api/customer/[...action]?action=orders/active"
    },
    {
      "source": "/api/reviews",
      "destination": "/api/catalog?publicView=reviews"
    },
    {
      "source": "/api/admin/audit",
      "destination": "/api/admin/dashboard?adminView=audit"
    },
    {
      "source": "/api/admin/scheduled",
      "destination": "/api/admin/dashboard?adminView=scheduled"
    },
    {
      "source": "/api/admin/metrics",
      "destination": "/api/admin/dashboard?adminView=metrics"
    }
  ],
  "headers": [
    {
      "source": "/lib/business-hours.cjs",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://maps.googleapis.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://maps.gstatic.com https://maps.googleapis.com; connect-src 'self' https://maps.googleapis.com https://graph.facebook.com; font-src 'self' data:; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": {
            "suf": ".vercel.app"
          }
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://maps.googleapis.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://maps.gstatic.com https://maps.googleapis.com; connect-src 'self' https://maps.googleapis.com https://graph.facebook.com; font-src 'self' data:; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/gestor",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/gestor/:path*",
      "destination": "/admin/:path*",
      "permanent": false
    },
    {
      "source": "/r/tokyo-sushi",
      "destination": "/r/tokyo-sushi/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.inovasfood.com.br"
        }
      ],
      "destination": "https://inovasfood.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.tokyosushidelivery.com.br"
        }
      ],
      "destination": "https://tokyosushidelivery.com.br/:path*",
      "permanent": true
    }
  ]
}
